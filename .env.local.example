# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email allowed to sign in (single-user app)
ALLOWED_EMAIL=

# console.anthropic.com → API Keys — server-side only, never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Local dev only — lets you sign in with a password instead of a magic link,
# so local development doesn't hit Supabase's email rate limit.
# Do NOT set these two in Vercel's environment variables.
ALLOW_DEV_LOGIN=
DEV_USER_PASSWORD=
